# ─── REQUIRED — BytePlus ModelArk (Seed 2.0 / Seedream / Seed Speech / OmniHuman) ───
ARK_API_KEY=
ARK_API_KEY_2=
ARK_API_KEY_3=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
ARK_REGION=ap-southeast

# ─── REQUIRED — Seedance 2.0 ───
SEEDANCE_API_KEY=
SEEDANCE_API_KEY_2=
SEEDANCE_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# ─── REQUIRED — Grounding (non-judged path) ───
TAVILY_API_KEY=
EXA_API_KEY=
GEMINI_API_KEY=

# ─── REQUIRED — Butterbase (promo BUTTERBASE0502 — submission butterbase0502) ───
BUTTERBASE_PROJECT_URL=https://YOUR-PROJECT.butterbase.dev
BUTTERBASE_PROJECT_ID=
BUTTERBASE_API_KEY=
BUTTERBASE_ANON_KEY=
BUTTERBASE_STORAGE_BUCKET=preopreel-renders

# ─── REQUIRED defaults ───
REDIS_URL=redis://localhost:6379
DEMO_MODE=replay                   # live | replay | hybrid
MAX_CONCURRENT_LANES=3
CRITIC_FIDELITY_THRESHOLD=0.75
MAX_REGEN_PER_BEAT=1

# ─── OPTIONAL ───
HYBRID_LIVE_BUDGET_S=8.0
USE_LEGACY_PROVIDERS=0
SHOW_INVARIANT_CHECKS=0            # demo debug toggle (Mara G.3)
QUEUE_BACKEND=memory               # memory | bullmq

# ─── PUBLIC (Next.js client-side) ───
NEXT_PUBLIC_BUTTERBASE_PROJECT_URL=
NEXT_PUBLIC_BUTTERBASE_ANON_KEY=
NEXT_PUBLIC_DEMO_MODE=replay
